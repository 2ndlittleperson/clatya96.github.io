# Git remote settings for this site.
#
# Edit the values below, then run one of:
#   powershell -File scripts\set-remote.ps1
#   bash scripts/set-remote.sh
#
# Format is KEY=value, one per line. No quotes, no spaces around the "=".
# Lines starting with "#" are ignored.

# --- Primary remote: pushed to by "git push origin main" ---
GITHUB_HOST=github.krafton.com
GITHUB_USER=clatya96
GITHUB_REPO=clatya96.site.test

# --- Secondary remote: kept so the old destination stays available. ---
# Clear ALT_GITHUB_HOST (leave it empty) to drop this remote entirely.
ALT_REMOTE_NAME=github-com
ALT_GITHUB_HOST=github.com
ALT_GITHUB_USER=clatya96
ALT_GITHUB_REPO=clatya96.github.io
